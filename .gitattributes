# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Scripts that must keep their line endings whatever the platform.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files: never touch line endings or try to diff them.
*.png binary
*.webp binary
*.jar binary
*.jks binary
*.keystore binary
*.p12 binary
